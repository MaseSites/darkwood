# Copy to .env and fill in. NEVER commit .env.

# --- Anthropic ---------------------------------------------------------------
# OPTIONAL. Only needed for `--brain api`, which bills per token and is the only
# path that supports the batch endpoint -- so it is the one for long backtests.
# For live proposals use `--brain subscription`, which asks through a signed-in
# Claude account (`claude setup-token`) and needs nothing here.
ANTHROPIC_API_KEY=

# --- Bybit -------------------------------------------------------------------
# The API key MUST have trading rights but NO withdrawal rights.
# Testnet keys come from https://testnet.bybit.com — keep mainnet keys out until
# stage 10 of the plan.
TB_BYBIT__API_KEY=
TB_BYBIT__API_SECRET=

# true = testnet (the default, and the only sane setting before stage 10).
TB_BYBIT__TESTNET=true

# --- Kill switch -------------------------------------------------------------
# If this file exists, no order is ever sent. Checked before every send.
TB_KILL_SWITCH_FILE=data/KILL_SWITCH
