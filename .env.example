# Copy to .env and fill in. NEVER commit .env.

# --- Claude ------------------------------------------------------------------
# Fill in ONE of these, or neither.
#
# The token is the easier one. Run `claude setup-token`, which prints a
# long-lived token, and paste it here. `--brain subscription` then asks through
# your Claude account with no per-call bill.
#
# You can skip it entirely by signing the CLI in instead: run `claude`, then
# /login. That writes the credentials the CLI uses on its own, and this stays
# empty.
CLAUDE_CODE_OAUTH_TOKEN=

# Only needed for `--brain api`, which bills per token and is the only path with
# a batch endpoint -- so it is the one for long backtests, not for live use.
ANTHROPIC_API_KEY=

# --- Bybit -------------------------------------------------------------------
# The API key MUST have trading rights but NO withdrawal rights.
# Testnet keys come from https://testnet.bybit.com — keep mainnet keys out until
# stage 10 of the plan.
TB_BYBIT__API_KEY=
TB_BYBIT__API_SECRET=

# true = testnet (the default, and the only sane setting before stage 10).
TB_BYBIT__TESTNET=true

# --- Kill switch -------------------------------------------------------------
# If this file exists, no order is ever sent. Checked before every send.
TB_KILL_SWITCH_FILE=data/KILL_SWITCH
