.env
.env.*
!.env.example

.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Anchored to the repository root. Without the leading slash this matches any
# directory named `data` at any depth -- including src/traidingbrain/data/, which
# is the exchange client, the store, the backfill and the validator. Those were
# silently untracked for the whole project, and nothing about a commit said so.
# `/data/*` statt `/data/`, und das ist kein Schoenheitsfehler: git steigt in
# ein ausgeschlossenes VERZEICHNIS nicht hinab, also kann keine spaetere
# Ausnahme etwas darin wieder hereinholen. Nur wenn der Ausschluss den
# Inhalt trifft, greift die Kette darunter.
/data/*
!/data/.gitkeep

# Die Manifeste eingefrorener Predictions sind nicht Daten, sondern die
# Behauptung ueber die Daten: Signatur, Datenstand, Zeilenzahl, Horizont,
# Pruefsumme. Die Parquet-Datei bleibt draussen -- sie ist gross und
# jederzeit neu zu rechnen -- der Nachweis kommt mit, sonst ist ein
# Ergebnis spaeter nicht mehr zuzuordnen.
# Das Point-in-Time-Universum ist aus demselben Grund drin wie die
# Manifeste unten: es ist keine Datenmenge, sondern eine Behauptung ueber
# Daten -- welche Symbole wann handelbar waren, und welche 31 von 906
# verschwunden sind. 200 KB, und ohne sie ist jede marktuebergreifende
# Zahl spaeter nicht mehr nachpruefbar.
!/data/universe/
!/data/universe/*.json

!/data/frozen/
/data/frozen/*
!/data/frozen/*/
/data/frozen/*/*
!/data/frozen/*/*.json

.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

/runs/
*.log

# Process ids of the detached paper trader and dashboard. They describe this
# machine's running processes, not the project, and a committed one would point
# at whatever happens to hold that number on somebody else's computer.
*.pid
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.parquet

.claude-flow/

# Local tool state from the claude-flow swarm, not project source.
/.swarm/

# Freqtrade: der Ausfuehrungskern. Konfiguration und Strategien sind Quellcode
# und werden verfolgt; Marktdaten, trainierte Modelle, Logs, Backtest-Ausgaben
# und die Trade-Datenbank sind Laufzeitzustand dieser Maschine.
/freqtrade/user_data/data/
/freqtrade/user_data/models/
/freqtrade/user_data/logs/
/freqtrade/user_data/backtest_results/
/freqtrade/user_data/notebooks/
/freqtrade/user_data/plot/
/freqtrade/user_data/hyperopt_results/

# Enthaelt JWT- und WebSocket-Schluessel des lokalen API-Servers. Erzeugt von
# scripts/freqtrade_setup.py, nie eingecheckt.
/freqtrade/user_data/config.local.json
data/arms_*.jsonl
data/arms_*.log

# Dauerbetrieb: Startdateien und Logs werden erzeugt, nicht gepflegt.
# `python scripts/dauerbetrieb.py --einrichten` schreibt sie neu.
data/dienst/
data/replay_fills_0311/
data/e17_maerkte.txt
data/quarantine/venue_ws/
data/manual_paper.sqlite
config_offen/plan.yaml
