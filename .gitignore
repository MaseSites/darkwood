.env
.env.*
!.env.example

.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Anchored to the repository root. Without the leading slash this matches any
# directory named `data` at any depth -- including src/traidingbrain/data/, which
# is the exchange client, the store, the backfill and the validator. Those were
# silently untracked for the whole project, and nothing about a commit said so.
/data/
!/data/.gitkeep

.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

/runs/
*.log
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.parquet

.claude-flow/

# Local tool state from the claude-flow swarm, not project source.
/.swarm/
